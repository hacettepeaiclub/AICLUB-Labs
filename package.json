{
  "name": "ai-club-labs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Premium interactive experiences that teach Computer Science and AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,tsx,css,md}\" playwright.config.ts",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,tsx,css,md}\" playwright.config.ts",
    "size": "node tools/bundle-size.mjs",
    "og": "node tools/og-images.mjs",
    "icons": "node tools/icons.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@scienceicons/react": "^0.0.14",
    "@types/matter-js": "^0.20.2",
    "clsx": "^2.1.1",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
